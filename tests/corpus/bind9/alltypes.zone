; One record (or more) of every type BIND 9.18 reads, written the way zone
; files are: relative names, parentheses across lines, comments, TTL
; units, mnemonics, split base64/hex. gen.sh loads it into named-checkzone
; (canonical dump: alltypes.canonical) and into named (AXFR:
; ../named-alltypes-axfr.hex).
$ORIGIN alltypes.example.
$TTL 1h
@               IN SOA  ns1 hostmaster (
                        2026100401 ; serial
                        2h         ; refresh
                        1h         ; retry
                        2w         ; expire
                        5m )       ; minimum
                NS      ns1
                NS      ns2.example.net.
ns1             A       192.0.2.53
                AAAA    2001:db8::53

; RFC 1035
a               A       192.0.2.1
ns              NS      ns1
cname           CNAME   a
ptr             PTR     a.alltypes.example.
hinfo           HINFO   "Generic PC" "Linux \"6.18\""
hinfo           HINFO   RFC8482 ""
mx              MX      10 mail
mx              MX      0 .
txt             TXT     "v=spf1 -all"
txt             TXT     ( "first" "second"
                          "semi;colon" "back\\slash" "tab\009" "\195\169" )
txt             TXT     unquoted
txt             TXT     ""
wks             WKS     192.0.2.1 tcp ( smtp http 443 )
wks             WKS     192.0.2.1 UDP domain
mb              MB      a
mg              MG      a
mr              MR      a
minfo           MINFO   rmail emailbx
null            NULL    \# 4 deadbeef
null            NULL    \# 0
